# Face++ API kalitlari — https://console.faceplusplus.com dan olinadi
FACEPP_API_KEY=
FACEPP_API_SECRET=

# Anthropic (Claude) API kalit — https://console.anthropic.com dan olinadi
# Bo'sh qoldirilsa, Claude validatsiya va AI tavsiya bosqichlari o'tkazib yuboriladi
ANTHROPIC_API_KEY=

# Frontend manzili (CORS uchun) — deploy qilingandan keyin to'ldiring
# Masalan: https://porla-ai.vercel.app
FRONTEND_URL=

# Server porti (ko'pchilik hosting platformalari buni o'zi belgilaydi)
PORT=3001
